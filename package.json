{
	"name": "the-rift-site-web-server",
	"version": "1.0.0",
	"description": "",
	"type": "module",
	"main": "dist/index.js",
	"scripts": {
		"dev": "node --watch --env-file-if-exists=.env src/index.ts",
		"build": "tsc -p tsconfig.build.json",
		"start": "node --env-file-if-exists=.env dist/index.js",
		"docker:build": "docker build -t the-rift-web-server .",
		"docker:start": "docker run --rm -p 4000:4000 --env-file .env -e PORT=4000 --add-host=host.docker.internal:host-gateway the-rift-web-server",
		"typecheck": "tsc",
		"test": "vitest run",
		"test:watch": "vitest",
		"prepare": "husky",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "eslint .",
		"lint:fix": "eslint --fix ."
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Jason-Liu-SE/rift-website-web-server.git"
	},
	"author": "",
	"license": "ISC",
	"bugs": {
		"url": "https://github.com/Jason-Liu-SE/rift-website-web-server/issues"
	},
	"homepage": "https://github.com/Jason-Liu-SE/rift-website-web-server#readme",
	"dependencies": {
		"cookie-parser": "^1.4.7",
		"express": "^5.3.0",
		"jose": "^6.2.17",
		"mongoose": "^9.12.0",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/cookie-parser": "^1.4.10",
		"@types/express": "^5.0.6",
		"@types/node": "^24.19.2",
		"@types/supertest": "^7.2.1",
		"eslint": "^10.14.0",
		"eslint-config-prettier": "^10.1.8",
		"globals": "^17.14.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.0",
		"mongodb-memory-server": "^11.3.0",
		"prettier": "3.9.10",
		"supertest": "^7.3.2",
		"typescript": "~6.0",
		"typescript-eslint": "^8.72.1",
		"vitest": "^5.1.0"
	},
	"lint-staged": {
		"*.{js,mjs,ts}": [
			"eslint --fix",
			"prettier --write"
		],
		"!(*.js|*.mjs|*.ts)": "prettier --write --ignore-unknown"
	}
}
