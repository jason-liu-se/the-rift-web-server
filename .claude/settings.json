{
	"$schema": "https://json.schemastore.org/claude-code-settings.json",
	"worktree": {
		"baseRef": "head"
	},
	"permissions": {
		"allow": [
			"Bash(npm test:*)",
			"Bash(npm run lint:*)",
			"Bash(npm run format:*)",
			"Bash(npm run typecheck:*)",
			"Bash(npm run build:*)",
			"Bash(npx prettier:*)",
			"Bash(npx eslint:*)",
			"Bash(npx tsc:*)",
			"Bash(npx vitest:*)",
			"Bash(git status:*)",
			"Bash(git diff:*)",
			"Bash(git log:*)",
			"Bash(git show:*)",
			"Bash(git blame:*)",
			"Bash(git branch:*)",
			"Bash(git add:*)",
			"Bash(git commit:*)",
			"Bash(git push -u origin:*)",
			"Bash(git branch -m:*)",
			"Bash(gh issue view:*)",
			"Bash(gh issue comment:*)",
			"Bash(gh pr view:*)",
			"Bash(gh pr create:*)",
			"Bash(gh pr diff:*)",
			"Bash(gh api -X PATCH repos/jason-liu-se/the-rift-web-server/issues/comments/:*)",
			"Bash(npm ci:*)"
		],
		"ask": [
			"Bash(gh stack push:*)",
			"Bash(gh stack sync:*)",
			"Bash(gh stack submit:*)",
			"Bash(gh stack merge:*)",
			"Bash(gh stack link:*)",
			"Bash(gh stack unstack:*)",
			"Bash(gh stack delete:*)"
		],
		"deny": [
			"Bash(git push --force:*)",
			"Bash(git push -f:*)",
			"Bash(git reset --hard:*)",
			"Read(./.env)",
			"Read(./.env.*)",
			"Bash(git push * main)",
			"Bash(git push * main *)",
			"Bash(git push *:main*)",
			"Bash(git push * --force*)",
			"Bash(git push * -f)",
			"Bash(git push * -f *)",
			"Bash(git push * +*)",
			"Bash(git branch -D *)",
			"Bash(git branch --delete *)"
		]
	},
	"hooks": {
		"PostToolUse": [
			{
				"matcher": "Edit|MultiEdit|Write",
				"hooks": [
					{
						"type": "command",
						"command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/format-edited-file.mjs\"",
						"timeout": 30
					}
				]
			},
			{
				"matcher": "Bash",
				"hooks": [
					{
						"type": "command",
						"command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/log-command.mjs\""
					}
				]
			}
		],
		"PostToolUseFailure": [
			{
				"matcher": "Bash",
				"hooks": [
					{
						"type": "command",
						"command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/log-command.mjs\""
					}
				]
			}
		]
	}
}
